{
  "name": "blindwire-web",
  "private": true,
  "version": "2.0.0-beta.3",
  "type": "module",
  "scripts": {
    "dev": "npm run wasm:dev && vite",
    "build": "tsc --noEmit && npm run wasm:release && vite build",
    "preview": "vite preview",
    "wasm:dev": "node scripts/build-wasm.mjs --dev",
    "wasm:release": "node scripts/build-wasm.mjs --release",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run build && npm test && npm run test:e2e"
  },
  "dependencies": {
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.3.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.4",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
